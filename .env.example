# ===========================================================================
# Centralized Data Quality & Observability Platform - configuration template
# ===========================================================================
# Copy to `.env` and replace every `change_me` value before starting the stack:
#
#     cp .env.example .env
#
# `.env` is git-ignored. This template must never contain a real secret.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Source database - the warehouse being monitored (commerce_db)
# ---------------------------------------------------------------------------
SOURCE_POSTGRES_USER=commerce
SOURCE_POSTGRES_PASSWORD=change_me_source
SOURCE_POSTGRES_DB=commerce_db
SOURCE_POSTGRES_HOST=postgres-source
SOURCE_POSTGRES_PORT=5432
# Host-side published port. 5462 avoids the WinNAT reserved ranges and the
# ports used by the author's other local stacks.
SOURCE_POSTGRES_HOST_PORT=5462

# ---------------------------------------------------------------------------
# Platform database - observability metadata, Airflow and Marquez
# ---------------------------------------------------------------------------
PLATFORM_POSTGRES_USER=platform
PLATFORM_POSTGRES_PASSWORD=change_me_platform
PLATFORM_POSTGRES_DB=platform_db
PLATFORM_POSTGRES_HOST=postgres-platform
PLATFORM_POSTGRES_PORT=5432
PLATFORM_POSTGRES_HOST_PORT=5463

# Databases created inside the platform server by sql/platform/00_databases.sql
OBSERVABILITY_DB=observability_db
AIRFLOW_DB=airflow_db
MARQUEZ_DB=marquez_db

# Roles that own those databases
OBSERVABILITY_DB_USER=observability
OBSERVABILITY_DB_PASSWORD=change_me_observability
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow
MARQUEZ_DB_USER=marquez
MARQUEZ_DB_PASSWORD=change_me_marquez

# ---------------------------------------------------------------------------
# MinIO - object storage for the Parquet datasets
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_root
MINIO_HOST_API_PORT=9320
MINIO_HOST_CONSOLE_PORT=9321
MINIO_BUCKET=data-lake
MINIO_ENDPOINT=http://minio:9000
# Least-privilege service account used by the platform (not the root user)
MINIO_ACCESS_KEY=dq_platform
MINIO_SECRET_KEY=change_me_minio_service

# ---------------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------------
AIRFLOW_HOST_PORT=8293
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_admin
# Fernet key for connection/variable encryption. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change_me_fernet_key
# JWT signing secret for the Airflow 3 API server / task execution API.
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=change_me_jwt_secret
# Host UID/GID so files the containers write stay readable. 50000 matches the
# airflow user baked into the official image.
AIRFLOW_UID=50000

# ---------------------------------------------------------------------------
# Marquez - OpenLineage backend
# ---------------------------------------------------------------------------
MARQUEZ_HOST_API_PORT=5055
MARQUEZ_HOST_ADMIN_PORT=5056
MARQUEZ_HOST_WEB_PORT=3045
MARQUEZ_NAMESPACE=data-quality-platform
OPENLINEAGE_URL=http://marquez:5000

# ---------------------------------------------------------------------------
# Prometheus / Grafana
# ---------------------------------------------------------------------------
PROMETHEUS_HOST_PORT=9290
GRAFANA_HOST_PORT=3046
GRAFANA_ADMIN_USER=admin
# Grafana only applies this on the first initialisation of its own database.
# Changing it later requires recreating the grafana_data volume.
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# ---------------------------------------------------------------------------
# Platform services
# ---------------------------------------------------------------------------
# FastAPI read API (section 17)
DQ_API_HOST_PORT=8294
# Prometheus exporter (section 13)
DQ_EXPORTER_HOST_PORT=9291
DQ_EXPORTER_PORT=9091
# Alert webhook receiver (section 15)
ALERT_WEBHOOK_HOST_PORT=8295
ALERT_WEBHOOK_PORT=8000
# Shared secret the webhook receiver requires in the X-DQ-Token header.
ALERT_WEBHOOK_TOKEN=change_me_webhook_token

# ---------------------------------------------------------------------------
# Platform behaviour
# ---------------------------------------------------------------------------
# Deterministic generator seed. The same seed must reproduce the same dataset.
DQ_SEED=20240115
DQ_LOG_LEVEL=INFO
DQ_ENV=local

# ---------------------------------------------------------------------------
# Compose profiles
# ---------------------------------------------------------------------------
# `observability` adds Marquez, Prometheus, Grafana, the read API, the
# exporter and the webhook receiver on top of the always-on core services.
# With this set, a plain `docker compose up -d` brings up the whole platform.
# For the reduced development profile use `scripts/start.sh --dev`, which
# names the core services explicitly and leaves these out.
COMPOSE_PROFILES=observability

# OpenLineage emission is only switched off in the reduced profile, where
# Marquez is not running. scripts/start.sh --dev sets this to true.
OPENLINEAGE_DISABLED=false
